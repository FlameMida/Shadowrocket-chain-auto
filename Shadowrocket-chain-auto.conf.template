# 原版国外域名优先于国内 IP 判定；gfw/cn 使用同仓库文本适配，非 Mihomo 内置库。
RULE-SET,{{RULE_BASE}}/geolocation-!cn.list,默认代理
RULE-SET,{{RULE_BASE}}/gfw.list,默认代理
RULE-SET,{{RULE_BASE}}/cn.list,直连
IP-CIDR,192.168.0.0/16,直连,no-resolve
IP-CIDR,10.0.0.0/8,直连,no-resolve
IP-CIDR,172.16.0.0/12,直连,no-resolve
RULE-SET,{{RULE_BASE}}/private_ip.list,直连
GEOIP,CN,直连
FINAL,默认代理

[Host]
localhost = 127.0.0.1
doh.pub = 1.12.12.12
cloudflare-dns.com = 1.1.1.1
dns.google = 8.8.8.8
