RULE-SET,{{RULE_BASE}}/ai.list,AI
RULE-SET,{{RULE_BASE}}/google.list,Google
RULE-SET,{{RULE_BASE}}/google_ip.list,Google
RULE-SET,{{RULE_BASE}}/github.list,GitHub
RULE-SET,{{RULE_BASE}}/microsoft.list,Microsoft
